# EdgeMesh demo origin.
#
# The image is built from scratch with a static binary and a non-root user. A
# distroless-style final stage keeps the attack surface to the binary itself:
# there is no shell for an attacker who achieves code execution to pivot with.

# ---- build stage ----------------------------------------------------------
FROM golang:1.27-alpine AS build

# Build dependencies are cached in their own layer so a source change does not
# re-download the module graph.
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev
ARG TARGETOS=linux
ARG TARGETARCH
# CGO is disabled so the binary is fully static and runs in a scratch image.
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
    -o /out/origin-demo ./cmd/origin-demo

# ---- certificate and user staging ----------------------------------------
FROM alpine:3.21 AS staging
RUN apk add --no-cache ca-certificates tzdata && \
    adduser -D -u 65532 -g '' edgemesh

# ---- final stage ----------------------------------------------------------
FROM scratch

COPY --from=staging /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=staging /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=staging /etc/passwd /etc/passwd
COPY --from=build /out/origin-demo /usr/local/bin/origin-demo

USER 65532:65532
EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/origin-demo"]
