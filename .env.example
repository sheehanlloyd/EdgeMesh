# EdgeMesh environment variables.
#
# This file lists NAMES ONLY. Never put a real value here. Copy it to .env
# (which is git-ignored) and fill that in.

# Bearer token for the admin API. Required when admin_auth.enabled is true.
# Must be at least 16 characters; generate one with:
#   openssl rand -base64 32
EDGEMESH_ADMIN_TOKEN=

# Used by edgemeshctl.
EDGEMESH_SERVER=http://127.0.0.1:7101
EDGEMESH_TOKEN=

# Image tag used by docker compose and the image build.
EDGEMESH_VERSION=dev
